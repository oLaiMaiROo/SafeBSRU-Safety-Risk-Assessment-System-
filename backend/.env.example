# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ไฟล์ .env ไม่ขึ้น git)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=safety_db
# กุญแจลับสำหรับเซ็น token เข้าสู่ระบบ ใส่ข้อความสุ่มยาว ๆ อย่างน้อย 32 ตัวอักษร
# สร้างได้ด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me_to_a_long_random_string
